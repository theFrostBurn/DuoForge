{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duoforge.local/schemas/issue-v2.schema.json",
  "title": "DuoForge workflow-v2 issue",
  "type": "object",
  "required": [
    "issueId",
    "round",
    "raisedBy",
    "targetDocumentId",
    "category",
    "severity",
    "claim",
    "blocking",
    "resolutionStatus",
    "history",
    "externalKeys",
    "reviewerVerdicts",
    "editorialDecisions",
    "adoptions"
  ],
  "properties": {
    "issueId": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "raisedBy": { "enum": ["codex", "claude", "orchestrator", "user"] },
    "targetDocumentId": { "enum": ["A", "B", "merged"] },
    "category": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "major", "minor"] },
    "claim": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "resolutionStatus": {
      "enum": ["OPEN", "AWAITING_EVIDENCE", "AWAITING_USER", "DEFERRED", "RESOLVED", "SUPERSEDED"]
    },
    "externalKeys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "reviewerVerdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "sourceStep", "round", "targetDocumentId", "verdict", "rationale"],
        "properties": {
          "reviewer": { "enum": ["codex", "claude"] },
          "sourceStep": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1, "maximum": 3 },
          "targetDocumentId": { "enum": ["A", "B", "merged"] },
          "verdict": { "enum": ["AGREES", "PARTIALLY_AGREES", "DISAGREES", "UNVERIFIABLE"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "editorialDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["performedBy", "sourceStep", "round", "targetDocumentId", "disposition", "rationale", "locations"],
        "properties": {
          "performedBy": { "enum": ["codex", "claude"] },
          "sourceStep": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1, "maximum": 3 },
          "targetDocumentId": { "enum": ["A", "B", "merged"] },
          "disposition": { "enum": ["ACCEPTED", "PARTIALLY_ACCEPTED", "REJECTED", "DEFERRED"] },
          "rationale": { "type": "string", "minLength": 1 },
          "locations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "adoptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["performedBy", "sourceStep", "round", "sourceDocumentId", "proposedByProvider", "targetDocumentId", "disposition", "rationale", "locations"],
        "properties": {
          "performedBy": { "enum": ["codex", "claude"] },
          "sourceStep": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1, "maximum": 3 },
          "sourceDocumentId": { "enum": ["brief", "A", "B", "merged"] },
          "proposedByProvider": { "enum": ["codex", "claude"] },
          "targetDocumentId": { "enum": ["A", "B", "merged"] },
          "disposition": { "enum": ["ACCEPTED", "PARTIALLY_ACCEPTED", "REJECTED", "DEFERRED"] },
          "rationale": { "type": "string", "minLength": 1 },
          "locations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "history": { "type": "array", "minItems": 1 }
  },
  "not": {
    "anyOf": [
      { "required": ["target"] },
      { "required": ["ownerDecisions"] }
    ]
  },
  "additionalProperties": true
}
