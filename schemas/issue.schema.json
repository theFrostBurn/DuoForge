{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duoforge.local/schemas/issue.schema.json",
  "title": "DuoForge issue",
  "type": "object",
  "required": [
    "issueId",
    "round",
    "raisedBy",
    "target",
    "category",
    "severity",
    "claim",
    "blocking",
    "resolutionStatus",
    "history"
  ],
  "properties": {
    "issueId": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "raisedBy": { "enum": ["codex", "claude", "orchestrator", "user"] },
    "target": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "major", "minor"] },
    "claim": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "resolutionStatus": {
      "enum": ["OPEN", "AWAITING_EVIDENCE", "AWAITING_USER", "DEFERRED", "RESOLVED", "SUPERSEDED"]
    },
    "history": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
